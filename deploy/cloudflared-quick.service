[Unit]
Description=Cloudflare Quick Tunnel for Kanoodle
After=network-online.target kanoodle.service
Wants=network-online.target
Requires=kanoodle.service

[Service]
Type=simple
# Quick Tunnel: no account and no domain needed, but the hostname is
# random and changes on every restart. Find the current one with:
#   journalctl -u cloudflared-quick | grep trycloudflare
ExecStart=/usr/local/bin/cloudflared --no-autoupdate tunnel --url http://localhost:8080
Restart=always
RestartSec=5

DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
